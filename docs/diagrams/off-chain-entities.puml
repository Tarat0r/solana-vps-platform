@startuml
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowFontSize 12
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 55
title Off-chain state: configuration, temporary sessions, payment recovery
allowmixing
hide circle

package "Linux server (implemented)" #FFF0D9 {
  entity "Daemon configuration" as Config {
    program_id / provider_pubkey / server_id
    unix_user / cluster / rpc_url
    auth_gateway / auth_origin / socket_path
    gateway_token <<secret>>
  }
  entity "Daemon session (memory)" as AuthSession {
    challenge bytes / session_id / nonce
    expiry / monotonic deadline
    consumed flag
    original PAM connection
  }
}
package "Gateway (planned)" #EAF7ED {
  entity "Relay session (memory)" as Relay {
    session_id
    challenge_base64 / expires_at
    optional wallet / signature_base64
  }
}
package "Browser (planned)" #EAF2FF {
  entity "Public deployment configuration" as PublicConfig {
    cluster / program_id / provider / server_id
    rpc_url / SSH host / port / unix_user
  }
  entity "Pending payment (browser storage)" as Pending {
    cluster / program / server / wallet
    operation / payment_id
    transaction signature / validity metadata
  }
}
cloud "Solana: durable payment and access state" as Chain #EDE4FF

Config ..> AuthSession : Binds login identity
AuthSession ..> Relay : Exact published challenge
PublicConfig ..> Pending : Identifies payment target
Pending ..> Chain : Reconcile finalized receipt
AuthSession ..> Chain : Read finalized authorization

legend bottom
  No application database or order state.
  Gateway/daemon restarts discard pending login sessions; start a new SSH attempt.
  Browser metadata helps recover payments but never authorizes access.
  Never expose daemon tokens or signing keys to the browser.
endlegend
@enduml
