@startuml
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowFontSize 12
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 55
title Wallet-authenticated SSH: target architecture
left to right direction

actor "Owner / delegate" as User #EAF2FF
actor "Provider" as Provider #EAF2FF
package "Client applications" #EAF2FF {
  component "Browser wallet\nOwner dashboard + signing page\n(planned)" as Browser #EAF2FF
  component "OpenSSH client" as Client #EAF2FF
  artifact "Provider Bash script\nRegister / enable / disable\n(planned)" as Setup #EAF2FF
}
node "Web service (planned)" #EAF7ED {
  component "Frontend hosting + auth gateway\nTemporary challenges / proofs" as Gateway #EAF7ED
}
node "Existing Linux server" #FFF0D9 {
  component "OpenSSH + pam_solana.so\n+ solana-authd\n(implemented)" as SSH #FFF0D9
}
cloud "Solana" #EDE4FF {
  component "Devnet RPC" as RPC #EDE4FF
  database "Billing/access program + accounts\n(planned)" as Chain #EDE4FF
}

User --> Browser
User --> Client
Provider --> Setup : Run manually
Client --> SSH : SSH
Browser --> Gateway : HTTPS: page + login proof
SSH --> Gateway : Publish challenge / poll proof
Browser --> RPC : Owner-signed transactions\nRead finalized access / receipts
Setup --> RPC : Provider-signed transactions
SSH --> RPC : Read finalized access
RPC --> Chain

legend bottom
  Target: one prepared Linux server; no ordering or payment-triggered provisioning.
  The daemon alone authorizes new logins. Payment is separate from login signing.
  Current local tests use synthetic gateway/RPC services and a CLI signer.
endlegend
@enduml
