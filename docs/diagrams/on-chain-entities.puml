@startuml
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam ArrowFontSize 12
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 55
title On-chain accounts: existing decoder contract + planned receipts
hide circle
skinparam linetype ortho

entity "ServerRecord (PDA)" as ServerRecord #EDE4FF {
  provider : Pubkey
  server_id : bytes32
  owner_wallet : Pubkey
  treasury : Pubkey
  price_lamports : u64
  period_seconds : i64
  enabled : bool
  bump : u8
}
entity "Subscription (PDA)" as Subscription #EDE4FF {
  server : Pubkey
  owner_wallet : Pubkey
  paid_until : i64
  bump : u8
}
entity "AccessGrant (PDA)" as AccessGrant #EDE4FF {
  server : Pubkey
  wallet : Pubkey
  grant_type : u8 [OWNER=0 / DELEGATED=1]
  active : bool
  valid_until : i64
  bump : u8
}
entity "PaymentReceipt (planned PDA)" as PaymentReceipt #EAF7ED {
  server : Pubkey
  payer : Pubkey
  payment_id : bytes32
  amount_lamports : u64
  paid_at : i64
  resulting_paid_until : i64
}

ServerRecord ||--|| Subscription : paid term
ServerRecord ||--o{ AccessGrant : owner / delegates
ServerRecord ||--o{ PaymentReceipt : payments

note bottom of Subscription
  Registration creates an unpaid subscription.
  Payment updates its expiry and the owner grant atomically.
end note
legend bottom
  ServerRecord / Subscription / AccessGrant retain the Rust decoder's
  discriminator, ordered Borsh fields, seeds, bumps, and role encoding.
  PaymentReceipt is the planned billing model; encoding is defined with the program.
  The daemon does not read payment receipts during login.
endlegend
@enduml
