[Unit]
Description=Solana wallet SSH authorization daemon
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/sbin/solana-authd /etc/solana-auth/server.toml
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# The only devices used are terminals, to warn wallet logins before their
# access ends; group tty may write to those whose users allow messages.
DevicePolicy=closed
DeviceAllow=char-pts w
SupplementaryGroups=tty
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/run
MemoryMax=256M
TasksMax=128
LimitNOFILE=256
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
