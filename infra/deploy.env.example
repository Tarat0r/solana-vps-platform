# Settings for infra/deploy.sh; copy to infra/deploy.env (git-ignored) and edit.
# Every server is reached through one public address with its own SSH port.
SSH_HOST=203.0.113.10
# Your administration key; root logs in with it only.
SSH_KEY=~/.ssh/id_ed25519

# The backend serves the gateway and dashboard. DOMAIN must resolve to SSH_HOST,
# and PUBLIC_PORT must be forwarded to the backend's port 8080.
BACKEND_SSH_PORT=2201
DOMAIN=vps.example.com
PUBLIC_PORT=8443
# The backend's private address: the servers' daemons reach the gateway there,
# because the public address does not loop back inside the provider network.
BACKEND_PRIVATE_IP=10.0.0.4

# Servers for sale, in the order of ./run.sh --devnet's .run/devnet/server-N.id.
SERVER_SSH_PORTS=(2202 2203)
SERVER_NAMES=("Server 1" "Server 2")
